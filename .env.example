# OptiPeople website, environment variables
# Copy this file to `.env.local` for local development, and configure the same
# keys in the Vercel project settings (Production, Preview, Development).

# --- Site URL -------------------------------------------------------------
# Absolute base URL of the deployed site. Used for canonical URLs, Open Graph
# tags, sitemap.xml, and robots.txt. Set this to the real production domain.
# If unset, the code falls back to https://optipeople-website.vercel.app
NEXT_PUBLIC_SITE_URL=https://optipeople-website.vercel.app

# --- Contact & newsletter forms (monday.com) ------------------------------
# API token used by /api/contact and /api/newsletter to create items in
# monday.com. Without it, form submissions return HTTP 500.
MONDAY_API_TOKEN=

# --- Decap CMS GitHub OAuth (/admin) --------------------------------------
# GitHub OAuth App credentials used by /api/auth and /api/auth/callback so
# editors can sign in to the CMS at /admin. Without them, /admin login fails.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
